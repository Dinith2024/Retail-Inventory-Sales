<Window x:Class="RetailInventorySales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RetailInventorySales.Views"
        Title="Retail Inventory &amp; Sales"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Retail Inventory &amp; Sales" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="0" BorderThickness="0" Background="{StaticResource BackgroundBrush}" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Dashboard">
                <views:DashboardView x:Name="DashboardTab"/>
            </TabItem>
            <TabItem Header="Products">
                <views:ProductsView x:Name="ProductsTab"/>
            </TabItem>
            <TabItem Header="Sales">
                <views:SalesView x:Name="SalesTab"/>
            </TabItem>
            <TabItem Header="Stock Management">
                <views:StockView x:Name="StockTab"/>
            </TabItem>
            <TabItem Header="Transaction History">
                <views:HistoryView x:Name="HistoryTab"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>